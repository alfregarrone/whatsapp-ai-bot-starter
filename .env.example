# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Modelo de chat ──────────────────────────────────────────
# groq | anthropic
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# ── Embeddings (solo para la ingesta y la búsqueda) ─────────
OPENAI_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small

# ── WhatsApp Cloud API ──────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
# Cualquier string que elijas; se lo pegás a Meta al dar de alta el webhook.
WHATSAPP_VERIFY_TOKEN=

# ── Negocio ─────────────────────────────────────────────────
BUSINESS_NAME=Mi Negocio
BUSINESS_INSTRUCTIONS=Atendemos de lunes a viernes de 9 a 18. No damos precios por WhatsApp sin antes pedir el modelo.

# ── Modo demo ───────────────────────────────────────────────
# true = el bot responde con el FAQ de ejemplo embebido, sin Supabase ni
# embeddings. Solo hace falta la clave del modelo de chat. Para la demo pública.
DEMO_MODE=false
